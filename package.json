{
  "name": "deerontour",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -k -n BACKEND,FRONTEND \"npm run start --workspace=blog_bc\" \"npm run start --workspace=my-app\"",
    "dev:backend": "npm run start --workspace=blog_bc",
    "dev:frontend": "npm run start --workspace=my-app",
    "build": "npm run build --workspace=my-app"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}